---
/*
 * ToothWire — 3D point-to-point mesh wireframe of a tooth-like surface.
 * Renders empty SVG + dataset; a single page-level script (mounted below)
 * builds the mesh, projects it per frame, and updates the SVG.
 *
 * Variants tune the parametric tooth profile:
 *   "molar"     — 4-cusp crown, broad shoulder, short twin root
 *   "incisor"   — single-edge blade crown, long tapered root
 *   "canine"    — single pointed cusp, long single root
 */
interface Props {
  variant?: "molar" | "incisor" | "canine";
  size?: number;
  class?: string;
  /** Accent colour as CSS value or tailwind token. Defaults to currentColor. */
  color?: string;
  /** Rotation speed multiplier. 1 = default. 0 = static. */
  speed?: number;
  /** Initial Y rotation (degrees). */
  start?: number;
  /** Tilt around X axis (radians). */
  tilt?: number;
  /** Vertex density: latitude rings × longitude segments. */
  lat?: number;
  lon?: number;
}
const {
  variant = "molar",
  size = 360,
  class: cls = "",
  color = "currentColor",
  speed = 1,
  start = 0,
  tilt = 0.45,
  lat = 14,
  lon = 22,
} = Astro.props;
---

<div
  class={`tw-mesh inline-block max-w-full ${cls}`}
  style={`color:${color}; width:${size}px; max-width:100%; aspect-ratio: 1 / 1;`}
  data-variant={variant}
  data-speed={speed}
  data-start={start}
  data-tilt={tilt}
  data-lat={lat}
  data-lon={lon}
  data-size={size}
  aria-hidden="true"
>
  <svg viewBox={`0 0 ${size} ${size}`}
       xmlns="http://www.w3.org/2000/svg"
       preserveAspectRatio="xMidYMid meet"
       style="display:block; overflow:visible; width:100%; height:100%;">
    <g class="tw-edges" stroke="currentColor" fill="none" stroke-linecap="round" />
    <g class="tw-verts" fill="currentColor" stroke="none" />
  </svg>
</div>
