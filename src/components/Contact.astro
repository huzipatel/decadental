---
import ToothWire from "./ToothWire.astro";
---

<section id="contact" class="relative bg-void border-b border-graphite overflow-hidden">
  <!-- ambient mesh backdrop (lg+ only) -->
  <div class="absolute -right-40 top-0 text-neon/15 pointer-events-none hidden lg:block">
    <ToothWire variant="molar" size={700} speed={0.4} tilt={0.5} lat={14} lon={22} />
  </div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 py-24 md:py-32 grid md:grid-cols-12 gap-12 items-start">

    <div class="md:col-span-5">
      <p class="eyebrow crosshair">module 06 // initialise</p>
      <h2 class="display-lg mt-6 text-bone">
        Open a<br/><span class="text-neon glow-neon">session.</span>
      </h2>
      <p class="mt-8 text-mist text-[15px] leading-[1.65] max-w-md">
        New patient enquiries close within one working day. Existing patients,
        phone the practice during access hours. Emergencies — phone any time.
      </p>

      <div class="mt-12 space-y-6">
        <div>
          <p class="eyebrow eyebrow-fog">channel.phone</p>
          <a href="tel:+440000000000" class="font-display font-medium text-[24px] tnum text-neon hover:text-acid mt-1 block">0000 000 0000</a>
        </div>
        <div>
          <p class="eyebrow eyebrow-fog">channel.email</p>
          <a href="mailto:hello@decadental.com" class="font-mono text-[16px] text-bone hover:text-neon mt-1 block break-all">hello@decadental.com</a>
        </div>
        <div>
          <p class="eyebrow eyebrow-fog">node.address</p>
          <address class="not-italic mt-1 text-mist text-[14px] leading-[1.7] font-mono">
            Decadental — node 01<br/>
            Street address<br/>
            London · Postcode<br/>
            United Kingdom
          </address>
        </div>
      </div>
    </div>

    <!-- Form -->
    <div class="md:col-span-7 hud p-6 md:p-8">
      <div class="flex items-center justify-between border-b border-graphite pb-4 mb-6">
        <p class="eyebrow">form // intake</p>
        <span class="font-mono text-[10px] text-neon">● ready</span>
      </div>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/?contact=ok#contact"
        class="grid grid-cols-1 sm:grid-cols-2 gap-5"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden"><label>Don't fill: <input name="bot-field" /></label></p>

        <label class="block sm:col-span-1">
          <span class="eyebrow eyebrow-fog">field.name</span>
          <input required name="name" autocomplete="name"
            class="mt-2 w-full bg-void border border-graphite px-3 py-3 text-[15px] font-mono text-bone focus:outline-none focus:border-neon focus:text-neon" />
        </label>
        <label class="block sm:col-span-1">
          <span class="eyebrow eyebrow-fog">field.phone</span>
          <input required name="phone" type="tel" autocomplete="tel"
            class="mt-2 w-full bg-void border border-graphite px-3 py-3 text-[15px] font-mono text-bone focus:outline-none focus:border-neon focus:text-neon" />
        </label>
        <label class="block sm:col-span-2">
          <span class="eyebrow eyebrow-fog">field.email</span>
          <input required name="email" type="email" autocomplete="email"
            class="mt-2 w-full bg-void border border-graphite px-3 py-3 text-[15px] font-mono text-bone focus:outline-none focus:border-neon focus:text-neon" />
        </label>
        <fieldset class="sm:col-span-2">
          <legend class="eyebrow eyebrow-fog">field.window</legend>
          <div class="mt-2 grid grid-cols-2 sm:grid-cols-4 gap-2 font-mono text-[12px] uppercase tracking-[0.18em]">
            {["07-12","12-17","17-22","Sat"].map(t => (
              <label class="flex items-center justify-center gap-2 border border-graphite px-3 py-3 cursor-pointer has-[:checked]:border-neon has-[:checked]:text-neon has-[:checked]:bg-onyx text-mist transition-colors">
                <input type="checkbox" name="window" value={t} class="sr-only" />
                {t}
              </label>
            ))}
          </div>
        </fieldset>
        <label class="block sm:col-span-2">
          <span class="eyebrow eyebrow-fog">field.notes</span>
          <textarea name="message" rows="4"
            class="mt-2 w-full bg-void border border-graphite px-3 py-3 text-[15px] font-mono text-bone focus:outline-none focus:border-neon focus:text-neon"></textarea>
        </label>
        <button
          type="submit"
          class="sm:col-span-2 inline-flex items-center justify-center gap-3 bg-neon text-void font-mono uppercase tracking-[0.22em] text-[13px] px-7 py-4 hover:bg-acid transition-colors"
        >
          → transmit
        </button>
        <p class="sm:col-span-2 font-mono text-[11px] text-fog uppercase tracking-[0.18em]">expected response · &lt; 1 working day</p>
      </form>
    </div>
  </div>
</section>
