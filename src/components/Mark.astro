---
interface Props { size?: number; class?: string }
const { size = 56, class: cls = "" } = Astro.props;
---
<!-- Decadental mark: hexagonal node with embedded tooth abstraction. -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"
     width={size} height={size} class={cls} aria-hidden="true"
     fill="none" stroke="currentColor" stroke-width="1.5">
  <!-- Outer hexagon -->
  <path d="M 32 4 L 56 18 L 56 46 L 32 60 L 8 46 L 8 18 Z" stroke-opacity="0.95" />
  <!-- Inner hexagon -->
  <path d="M 32 14 L 48 23 L 48 41 L 32 50 L 16 41 L 16 23 Z" stroke-opacity="0.5" />
  <!-- Tooth glyph: stylized crown + root -->
  <path d="M 24 24 Q 26 20 32 20 Q 38 20 40 24 L 41 34 Q 38 38 32 38 Q 26 38 23 34 Z"
        stroke-width="1.4" />
  <path d="M 30 38 L 30 46 M 34 38 L 34 46" stroke-width="1.2" stroke-opacity="0.85" />
  <!-- Centre crosshair -->
  <circle cx="32" cy="29" r="1.5" fill="currentColor" stroke="none" />
</svg>
