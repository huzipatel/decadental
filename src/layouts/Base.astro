---
import "../styles/global.css";
import ToothWireScript from "../components/ToothWireScript.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}
const {
  title = "DECADENTAL // Dentistry, recompiled.",
  description = "DECADENTAL — a forward-deployed dental practice. Considered work, late hours, modern systems. London.",
  canonical,
} = Astro.props;
const site = Astro.site?.toString() ?? "https://decadental.com";
const canon = canonical ?? site;
---
<!doctype html>
<html lang="en-GB" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050608" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Dentist",
      "name": "Decadental",
      "slogan": "Dentistry, recompiled.",
      "url": site,
      "telephone": "+44 0000 000 0000",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "London",
        "addressCountry": "GB"
      }
    })} />
  </head>
  <body>
    <slot />
    <ToothWireScript />
  </body>
</html>
